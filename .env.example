# Free trial at: https://serpapi.com/users/sign_up
SERPAPI_KEY=

# ── Defaults ─────────────────────────────────────────────────────────────────
DEFAULT_CURRENCY=USD
POLL_INTERVAL_MINUTES=30
DATA_DIR=data
