# No API key is required — the default provider scrapes Google Flights
# via the fast-flights library.

# ── SerpApi (optional, more structured data) ─────────────────────────────────
# Free trial at: https://serpapi.com/users/sign_up
SERPAPI_KEY=

# ── Defaults ─────────────────────────────────────────────────────────────────
DEFAULT_CURRENCY=USD
POLL_INTERVAL_MINUTES=30
DATA_DIR=data

# ── 24/7 price watch ─────────────────────────────────────────────────────────
# How often the background watcher re-samples each watched fare (minutes).
WATCH_INTERVAL_MINUTES=30

# ── Email alerts (optional — fill to receive price-drop emails) ──────────────
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com,
# SMTP_PASSWORD=<Google app password>, ALERT_TO=you@gmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_FROM=
ALERT_TO=

# ── Access lock (set before exposing the app via a public tunnel) ────────────
# Blank = no login (local / home Wi-Fi). Any value = require ?token=... to enter.
APP_TOKEN=
